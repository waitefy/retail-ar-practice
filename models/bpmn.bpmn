<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Original" targetNamespace="https://github.com/waitefy/retail-ar-practice/models/original">
  <bpmn:dataStore id="Store_Catalog" name="Каталог интернет-магазина" isUnlimited="true">
    <bpmn:documentation>Товары, варианты, оттенки, материалы каталога и материалы вариантов. Общие фотографии и палитры используются несколькими вариантами; данные готовит продавец до посещения покупателя.</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:process id="Process_Original" name="Исходный процесс ознакомления с товаром" isExecutable="false">
    <bpmn:documentation>Исходный процесс из раздела 2.2 отчёта: обычная карточка интернет-магазина без AR. Голубым отмечены операции, передаваемые разрабатываемой программе. Сравнение и решение выполняет покупатель. Покупка, оплата и доставка находятся за границами процесса.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Original">
      <bpmn:lane id="Lane_Buyer" name="Покупатель">
        <bpmn:flowNodeRef>Start_Card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Study</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Change</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shop" name="Интернет-магазин">
        <bpmn:flowNodeRef>GW_Repeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Selection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Selected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoSelection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Card" name="Карточка товара открыта">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Repeat" name="">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Details" name="Предоставить сведения о варианте">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:ioSpecification id="Task_Details_IO">
        <bpmn:dataInput id="D01_Port"/>
        <bpmn:dataOutput id="D02_Port"/>
        <bpmn:inputSet id="Task_Details_inSet">
          <bpmn:dataInputRefs>D01_Port</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_Details_outSet">
          <bpmn:dataOutputRefs>D02_Port</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="D01">
        <bpmn:sourceRef>Data_Catalog</bpmn:sourceRef>
        <bpmn:targetRef>D01_Port</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="D02">
        <bpmn:sourceRef>D02_Port</bpmn:sourceRef>
        <bpmn:targetRef>Data_Details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Presentation" name="Представить внешний вид варианта">
      <bpmn:documentation>До внедрения AR магазин показывает фотографии, образцы цвета и палитры из каталога. В разрабатываемой программе эту функцию дополняет визуализация на изображении покупателя: подготовка параметров, проверка входов, построение маски, цветовое наложение. Эти вычисления отсутствуют в исходном процессе.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:ioSpecification id="Task_Presentation_IO">
        <bpmn:dataInput id="D03_Port"/>
        <bpmn:dataOutput id="D04_Port"/>
        <bpmn:inputSet id="Task_Presentation_inSet">
          <bpmn:dataInputRefs>D03_Port</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_Presentation_outSet">
          <bpmn:dataOutputRefs>D04_Port</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="D03">
        <bpmn:sourceRef>Data_Details</bpmn:sourceRef>
        <bpmn:targetRef>D03_Port</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="D04">
        <bpmn:sourceRef>D04_Port</bpmn:sourceRef>
        <bpmn:targetRef>Data_Photos</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Study" name="Изучить сведения и фотографии">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:ioSpecification id="Task_Study_IO">
        <bpmn:dataInput id="D05_Port"/>
        <bpmn:inputSet id="Task_Study_inSet">
          <bpmn:dataInputRefs>D05_Port</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_Study_outSet"/>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="D05">
        <bpmn:sourceRef>Data_Photos</bpmn:sourceRef>
        <bpmn:targetRef>D05_Port</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Materials" name="Нужны дополнительные сведения?">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Reviews" name="Изучить отзывы и другие материалы">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Compare" name="Сравнить варианты и принять решение">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Decision" name="Решение покупателя?">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Change" name="Уточнить вариант для сравнения">
      <bpmn:documentation>Покупатель выбирает другой вариант или повторно рассматривает текущий.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Selection" name="Предоставить результат предварительного выбора">
      <bpmn:documentation>Магазин отображает текущий выбранный вариант; при выходе результатом служит отсутствие выбора. Это фиксация решения покупателя в рамках просмотра, без заказа и сохранения истории. Разветвление select/exit не является ошибкой обработки.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:ioSpecification id="Task_Selection_IO">
        <bpmn:dataInput id="D06_Port"/>
        <bpmn:dataOutput id="D07_Port"/>
        <bpmn:inputSet id="Task_Selection_inSet">
          <bpmn:dataInputRefs>D06_Port</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_Selection_outSet">
          <bpmn:dataOutputRefs>D07_Port</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="D06">
        <bpmn:sourceRef>Data_Catalog</bpmn:sourceRef>
        <bpmn:targetRef>D06_Port</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="D07">
        <bpmn:sourceRef>D07_Port</bpmn:sourceRef>
        <bpmn:targetRef>Data_Selection</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Outcome" name="Предварительный выбор сделан?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Selected" name="Товар и вариант предварительно выбраны">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoSelection" name="Просмотр завершён без выбора">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="Data_Catalog" name="Каталог: товары, варианты, оттенки, материалы, материалы вариантов" dataStoreRef="Store_Catalog"/>
    <bpmn:dataObject id="Data_Details_Object"/>
    <bpmn:dataObjectReference id="Data_Details" name="Сведения о товаре, варианте и оттенке" dataObjectRef="Data_Details_Object"/>
    <bpmn:dataObject id="Data_Photos_Object"/>
    <bpmn:dataObjectReference id="Data_Photos" name="Фотографии и палитра" dataObjectRef="Data_Photos_Object"/>
    <bpmn:dataObject id="Data_Selection_Object"/>
    <bpmn:dataObjectReference id="Data_Selection" name="Предварительный выбор или отсутствие выбора" dataObjectRef="Data_Selection_Object"/>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Card" targetRef="GW_Repeat"/>
    <bpmn:sequenceFlow id="F02" sourceRef="GW_Repeat" targetRef="Task_Details"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Task_Details" targetRef="Task_Presentation"/>
    <bpmn:sequenceFlow id="F04" sourceRef="Task_Presentation" targetRef="Task_Study"/>
    <bpmn:sequenceFlow id="F05" sourceRef="Task_Study" targetRef="GW_Materials"/>
    <bpmn:sequenceFlow id="F06" sourceRef="GW_Materials" targetRef="Task_Reviews" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">need_more_information</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F07" sourceRef="GW_Materials" targetRef="Task_Compare" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not need_more_information</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_Reviews" targetRef="Task_Compare"/>
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Compare" targetRef="GW_Decision"/>
    <bpmn:sequenceFlow id="F10" sourceRef="GW_Decision" targetRef="Task_Change" name="Продолжить сравнение">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == compare</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Change" targetRef="GW_Repeat"/>
    <bpmn:sequenceFlow id="F12" sourceRef="GW_Decision" targetRef="Task_Selection" name="Выбрать вариант">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == select</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="GW_Decision" targetRef="Task_Selection" name="Завершить без выбора">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == exit</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Selection" targetRef="GW_Outcome"/>
    <bpmn:sequenceFlow id="F15" sourceRef="GW_Outcome" targetRef="End_Selected" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == select</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="GW_Outcome" targetRef="End_NoSelection" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == exit</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Original">
    <bpmn:participant id="Pool_Original" name="Ознакомление с товаром и предварительный выбор" processRef="Process_Original"/>
    <bpmn:participant id="Pool_Seller" name="Представитель продавца"/>
    <bpmn:textAnnotation id="Note_Seller">
      <bpmn:text>Продавец заранее готовит каталог магазина. Подготовка каталога — за границами текущего процесса.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Original">
      <bpmn:text>Исходный процесс: обычная карточка магазина, без AR.
Голубые задачи передаются программе; сравнение и решение остаются за покупателем.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_SellerNote" sourceRef="Pool_Seller" targetRef="Note_Seller" associationDirection="None"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Original" name="Процесс до внедрения AR">
    <bpmndi:BPMNPlane id="Plane_Original" bpmnElement="Collaboration_Original">
      <bpmndi:BPMNShape id="Pool_Original_di" bpmnElement="Pool_Original" isHorizontal="true">
        <dc:Bounds x="60" y="140" width="2170" height="680"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Buyer_di" bpmnElement="Lane_Buyer" isHorizontal="true">
        <dc:Bounds x="90" y="140" width="2140" height="360"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Shop_di" bpmnElement="Lane_Shop" isHorizontal="true">
        <dc:Bounds x="90" y="500" width="2140" height="320"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Seller_di" bpmnElement="Pool_Seller" isHorizontal="true">
        <dc:Bounds x="60" y="20" width="300" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Seller_di" bpmnElement="Note_Seller">
        <dc:Bounds x="410" y="20" width="420" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Original_di" bpmnElement="Note_Original">
        <dc:Bounds x="1010" y="20" width="800" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Card_di" bpmnElement="Start_Card">
        <dc:Bounds x="180" y="330" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="110" y="390" width="120" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Repeat_di" bpmnElement="GW_Repeat">
        <dc:Bounds x="280" y="555" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Details_di" bpmnElement="Task_Details" bioc:fill="#e8f2ff" bioc:stroke="#000000">
        <dc:Bounds x="390" y="540" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Presentation_di" bpmnElement="Task_Presentation" bioc:fill="#e8f2ff" bioc:stroke="#000000">
        <dc:Bounds x="660" y="540" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Study_di" bpmnElement="Task_Study">
        <dc:Bounds x="660" y="310" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Materials_di" bpmnElement="GW_Materials">
        <dc:Bounds x="925" y="325" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="865" y="390" width="170" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reviews_di" bpmnElement="Task_Reviews">
        <dc:Bounds x="1000" y="200" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Compare_di" bpmnElement="Task_Compare">
        <dc:Bounds x="1240" y="310" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Decision_di" bpmnElement="GW_Decision">
        <dc:Bounds x="1500" y="325" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1555" y="390" width="140" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Change_di" bpmnElement="Task_Change">
        <dc:Bounds x="1390" y="200" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Selection_di" bpmnElement="Task_Selection" bioc:fill="#e8f2ff" bioc:stroke="#000000">
        <dc:Bounds x="1680" y="540" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Outcome_di" bpmnElement="GW_Outcome">
        <dc:Bounds x="1925" y="555" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1820" y="635" width="120" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Selected_di" bpmnElement="End_Selected">
        <dc:Bounds x="2062" y="520" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2010" y="565" width="140" height="50"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NoSelection_di" bpmnElement="End_NoSelection">
        <dc:Bounds x="2062" y="680" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2010" y="725" width="140" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Catalog_di" bpmnElement="Data_Catalog">
        <dc:Bounds x="430" y="680" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="360" y="735" width="190" height="50"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Details_di" bpmnElement="Data_Details">
        <dc:Bounds x="600" y="680" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="555" y="735" width="130" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Photos_di" bpmnElement="Data_Photos">
        <dc:Bounds x="900" y="680" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="850" y="735" width="140" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Selection_di" bpmnElement="Data_Selection">
        <dc:Bounds x="1710" y="680" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1660" y="735" width="140" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F01_di" bpmnElement="F01">
        <di:waypoint x="216" y="348"/>
        <di:waypoint x="240" y="348"/>
        <di:waypoint x="240" y="580"/>
        <di:waypoint x="280" y="580"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F02_di" bpmnElement="F02">
        <di:waypoint x="330" y="580"/>
        <di:waypoint x="390" y="580"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F03_di" bpmnElement="F03">
        <di:waypoint x="570" y="580"/>
        <di:waypoint x="660" y="580"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F04_di" bpmnElement="F04">
        <di:waypoint x="750" y="540"/>
        <di:waypoint x="750" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F05_di" bpmnElement="F05">
        <di:waypoint x="840" y="350"/>
        <di:waypoint x="925" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F06_di" bpmnElement="F06">
        <di:waypoint x="950" y="325"/>
        <di:waypoint x="950" y="240"/>
        <di:waypoint x="1000" y="240"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="963" y="285" width="30" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F07_di" bpmnElement="F07">
        <di:waypoint x="975" y="350"/>
