<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RetailAR" targetNamespace="https://github.com/waitefy/retail-ar-practice/models" exporter="Retail AR practice" exporterVersion="1.0">
  <bpmn:dataStore id="Store_Catalog" name="Проверенный каталог">
    <bpmn:documentation>Товары, варианты, оттенки, материалы и связи вариант–материал. Подготовлен продавцом до посещения покупателя.</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:process id="Process_Selection" name="Предварительное ознакомление с товаром и выбор варианта" isExecutable="false">
    <bpmn:documentation>Начало — открытие карточки; конец — предварительный выбор либо выход без выбора. AR необязателен. Модель не включает заказ, оплату и доставку. Каталог проверен при загрузке; идентификаторы выбираются из существующих вариантов.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Buyer" name="Покупатель">
        <bpmn:flowNodeRef>Start_Card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Study</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Change</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Приложение">
        <bpmn:flowNodeRef>GW_Repeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StopOrdinary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_AR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Selection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StopFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Selected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoSelection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Card" name="Карточка товара открыта">
      <bpmn:outgoing>M01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Repeat" name="">
      <bpmn:incoming>M01</bpmn:incoming>
      <bpmn:incoming>M11</bpmn:incoming>
      <bpmn:outgoing>M02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Details" name="Предоставить сведения о варианте">
      <bpmn:incoming>M02</bpmn:incoming>
      <bpmn:outgoing>M03</bpmn:outgoing>
      <bpmn:ioSpecification id="Task_Details_IO">
        <bpmn:dataInput id="D_CatalogIn_Input"/>
        <bpmn:dataOutput id="D_DetailsOut_Output"/>
        <bpmn:inputSet id="Task_Details_InputSet">
          <bpmn:dataInputRefs>D_CatalogIn_Input</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_Details_OutputSet">
          <bpmn:dataOutputRefs>D_DetailsOut_Output</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="D_CatalogIn">
        <bpmn:sourceRef>Data_Catalog</bpmn:sourceRef>
        <bpmn:targetRef>D_CatalogIn_Input</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="D_DetailsOut">
        <bpmn:sourceRef>D_DetailsOut_Output</bpmn:sourceRef>
        <bpmn:targetRef>Data_Details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Study" name="Изучить карточку и выбрать способ просмотра">
      <bpmn:documentation>Покупатель выбирает обычный просмотр или AR. Использование камеры допускается только после явного согласия; изображение может быть передано готовым снимком.</bpmn:documentation>
      <bpmn:incoming>M03</bpmn:incoming>
      <bpmn:outgoing>M04</bpmn:outgoing>
      <bpmn:ioSpecification id="Task_Study_IO">
        <bpmn:dataInput id="D_DetailsRead_Input"/>
        <bpmn:inputSet id="Task_Study_InputSet">
          <bpmn:dataInputRefs>D_DetailsRead_Input</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_Study_OutputSet"/>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="D_DetailsRead">
        <bpmn:sourceRef>Data_Details</bpmn:sourceRef>
        <bpmn:targetRef>D_DetailsRead_Input</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Mode" name="Способ просмотра?">
      <bpmn:incoming>M04</bpmn:incoming>
      <bpmn:outgoing>M05</bpmn:outgoing>
      <bpmn:outgoing>M06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_StopOrdinary" name="Прекратить AR-просмотр">
      <bpmn:documentation>Если источник кадров подключён, прекратить его использование и освободить камеру. При отсутствии активного источника действие ничего не меняет.</bpmn:documentation>
      <bpmn:incoming>M05</bpmn:incoming>
      <bpmn:outgoing>M07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SubProcess_AR" name="Выполнить AR-визуализацию">
      <bpmn:documentation>Детализация на диаграмме Diagram_AR. Источник изображения и контура — внешний компонент. Процедурная демонстрация получает массивы и камеру не открывает.</bpmn:documentation>
      <bpmn:incoming>M06</bpmn:incoming>
      <bpmn:outgoing>M08</bpmn:outgoing>
      <bpmn:startEvent id="AR_Start" name="Запрошен AR-просмотр">
        <bpmn:outgoing>A01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="AR_Source" name="Получить изображение и контур">
        <bpmn:documentation>Адаптер получает исходный кадр и контур извне; согласие на камеру и доступность материалов проверяются до её использования. В процедурной демонстрации входы передаются готовыми массивами.</bpmn:documentation>
        <bpmn:incoming>A01</bpmn:incoming>
        <bpmn:outgoing>A02</bpmn:outgoing>
        <bpmn:ioSpecification id="AR_Source_IO">
          <bpmn:dataOutput id="D_SourceOut_Output"/>
          <bpmn:inputSet id="AR_Source_InputSet"/>
          <bpmn:outputSet id="AR_Source_OutputSet">
            <bpmn:dataOutputRefs>D_SourceOut_Output</bpmn:dataOutputRefs>
          </bpmn:outputSet>
        </bpmn:ioSpecification>
        <bpmn:dataOutputAssociation id="D_SourceOut">
          <bpmn:sourceRef>D_SourceOut_Output</bpmn:sourceRef>
          <bpmn:targetRef>AR_Image</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:task>
      <bpmn:exclusiveGateway id="AR_Available" name="Входы доступны?">
        <bpmn:incoming>A02</bpmn:incoming>
        <bpmn:outgoing>A03</bpmn:outgoing>
        <bpmn:outgoing>A04</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_Parameters" name="Подготовить параметры наложения">
        <bpmn:incoming>A03</bpmn:incoming>
        <bpmn:outgoing>A05</bpmn:outgoing>
        <bpmn:ioSpecification id="Task_Parameters_IO">
          <bpmn:dataOutput id="D_ParamsOut_Output"/>
          <bpmn:inputSet id="Task_Parameters_InputSet"/>
          <bpmn:outputSet id="Task_Parameters_OutputSet">
            <bpmn:dataOutputRefs>D_ParamsOut_Output</bpmn:dataOutputRefs>
          </bpmn:outputSet>
        </bpmn:ioSpecification>
        <bpmn:dataOutputAssociation id="D_ParamsOut">
          <bpmn:sourceRef>D_ParamsOut_Output</bpmn:sourceRef>
          <bpmn:targetRef>AR_Params</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="AR_ParametersOK" name="Параметры готовы?">
        <bpmn:incoming>A05</bpmn:incoming>
        <bpmn:outgoing>A06</bpmn:outgoing>
        <bpmn:outgoing>A07</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_Validate" name="Проверить данные визуализации">
        <bpmn:incoming>A06</bpmn:incoming>
        <bpmn:outgoing>A08</bpmn:outgoing>
        <bpmn:ioSpecification id="Task_Validate_IO">
          <bpmn:dataInput id="D_ImageIn_Input"/>
          <bpmn:dataInput id="D_ParamsIn_Input"/>
          <bpmn:inputSet id="Task_Validate_InputSet">
            <bpmn:dataInputRefs>D_ImageIn_Input</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>D_ParamsIn_Input</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="Task_Validate_OutputSet"/>
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="D_ImageIn">
          <bpmn:sourceRef>AR_Image</bpmn:sourceRef>
          <bpmn:targetRef>D_ImageIn_Input</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="D_ParamsIn">
          <bpmn:sourceRef>AR_Params</bpmn:sourceRef>
          <bpmn:targetRef>D_ParamsIn_Input</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="AR_Valid" name="Данные корректны?">
        <bpmn:incoming>A08</bpmn:incoming>
        <bpmn:outgoing>A09</bpmn:outgoing>
        <bpmn:outgoing>A10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_Mask" name="Построить маску области губ">
        <bpmn:incoming>A09</bpmn:incoming>
        <bpmn:outgoing>A11</bpmn:outgoing>
        <bpmn:ioSpecification id="Task_Mask_IO">
          <bpmn:dataOutput id="D_MaskOut_Output"/>
          <bpmn:inputSet id="Task_Mask_InputSet"/>
          <bpmn:outputSet id="Task_Mask_OutputSet">
            <bpmn:dataOutputRefs>D_MaskOut_Output</bpmn:dataOutputRefs>
          </bpmn:outputSet>
        </bpmn:ioSpecification>
        <bpmn:dataOutputAssociation id="D_MaskOut">
          <bpmn:sourceRef>D_MaskOut_Output</bpmn:sourceRef>
          <bpmn:targetRef>AR_MaskData</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="AR_NonEmpty" name="Маска непустая?">
        <bpmn:incoming>A11</bpmn:incoming>
        <bpmn:outgoing>A12</bpmn:outgoing>
        <bpmn:outgoing>A13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_Apply" name="Наложить выбранный оттенок">
        <bpmn:documentation>Обработка всегда использует исходное изображение. Результат и временная маска существуют в памяти; пользовательские снимки не сохраняются.</bpmn:documentation>
        <bpmn:incoming>A12</bpmn:incoming>
        <bpmn:outgoing>A14</bpmn:outgoing>
        <bpmn:ioSpecification id="Task_Apply_IO">
          <bpmn:dataInput id="D_MaskIn_Input"/>
          <bpmn:dataOutput id="D_ResultOut_Output"/>
          <bpmn:inputSet id="Task_Apply_InputSet">
            <bpmn:dataInputRefs>D_MaskIn_Input</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="Task_Apply_OutputSet">
            <bpmn:dataOutputRefs>D_ResultOut_Output</bpmn:dataOutputRefs>
          </bpmn:outputSet>
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="D_MaskIn">
          <bpmn:sourceRef>AR_MaskData</bpmn:sourceRef>
          <bpmn:targetRef>D_MaskIn_Input</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="D_ResultOut">
          <bpmn:sourceRef>D_ResultOut_Output</bpmn:sourceRef>
          <bpmn:targetRef>AR_Result</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:endEvent id="AR_Success" name="Наложение готово">
        <bpmn:incoming>A14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="AR_FailureMerge" name="">
        <bpmn:incoming>A04</bpmn:incoming>
        <bpmn:incoming>A07</bpmn:incoming>
        <bpmn:incoming>A10</bpmn:incoming>
        <bpmn:incoming>A13</bpmn:incoming>
        <bpmn:outgoing>A15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="AR_Notify" name="Сообщить об ограничении">
        <bpmn:documentation>Сохранить доступ к обычной карточке. При корректном изображении показать исходный кадр без наложения; некорректное изображение не объявлять готовым результатом.</bpmn:documentation>
        <bpmn:incoming>A15</bpmn:incoming>
        <bpmn:outgoing>A16</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="AR_Stop" name="Прекратить AR-просмотр">
        <bpmn:documentation>Остановить активный источник кадров, если он был подключён, и освободить камеру. Повтор возможен после исправления входов через новое сравнение.</bpmn:documentation>
        <bpmn:incoming>A16</bpmn:incoming>
        <bpmn:outgoing>A17</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="AR_Fallback" name="Обычный просмотр доступен">
        <bpmn:incoming>A17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataObject id="AR_Image_Object"/>
      <bpmn:dataObjectReference id="AR_Image" name="Исходное изображение; контур" dataObjectRef="AR_Image_Object"/>
      <bpmn:dataObject id="AR_Params_Object"/>
      <bpmn:dataObjectReference id="AR_Params" name="Вариант; RGB оттенка; интенсивность" dataObjectRef="AR_Params_Object"/>
      <bpmn:dataObject id="AR_MaskData_Object"/>
      <bpmn:dataObjectReference id="AR_MaskData" name="Маска H × W" dataObjectRef="AR_MaskData_Object"/>
      <bpmn:dataObject id="AR_Result_Object"/>
      <bpmn:dataObjectReference id="AR_Result" name="Изображение с наложением" dataObjectRef="AR_Result_Object"/>
      <bpmn:sequenceFlow id="A01" sourceRef="AR_Start" targetRef="AR_Source"/>
      <bpmn:sequenceFlow id="A02" sourceRef="AR_Source" targetRef="AR_Available"/>
      <bpmn:sequenceFlow id="A03" sourceRef="AR_Available" targetRef="Task_Parameters" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">source_available</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A04" sourceRef="AR_Available" targetRef="AR_FailureMerge" name="Нет">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not source_available</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A05" sourceRef="Task_Parameters" targetRef="AR_ParametersOK"/>
      <bpmn:sequenceFlow id="A06" sourceRef="AR_ParametersOK" targetRef="Task_Validate" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">parameters.ok</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A07" sourceRef="AR_ParametersOK" targetRef="AR_FailureMerge" name="Нет">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not parameters.ok</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A08" sourceRef="Task_Validate" targetRef="AR_Valid"/>
      <bpmn:sequenceFlow id="A09" sourceRef="AR_Valid" targetRef="Task_Mask" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validation.ok</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A10" sourceRef="AR_Valid" targetRef="AR_FailureMerge" name="Нет">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not validation.ok</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A11" sourceRef="Task_Mask" targetRef="AR_NonEmpty"/>
      <bpmn:sequenceFlow id="A12" sourceRef="AR_NonEmpty" targetRef="Task_Apply" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mask.ok</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A13" sourceRef="AR_NonEmpty" targetRef="AR_FailureMerge" name="Нет">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not mask.ok</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A14" sourceRef="Task_Apply" targetRef="AR_Success"/>
      <bpmn:sequenceFlow id="A15" sourceRef="AR_FailureMerge" targetRef="AR_Notify"/>
      <bpmn:sequenceFlow id="A16" sourceRef="AR_Notify" targetRef="AR_Stop"/>
      <bpmn:sequenceFlow id="A17" sourceRef="AR_Stop" targetRef="AR_Fallback"/>
    </bpmn:subProcess>
    <bpmn:userTask id="Task_Compare" name="Сравнить варианты и принять решение">
      <bpmn:incoming>M07</bpmn:incoming>
      <bpmn:incoming>M08</bpmn:incoming>
      <bpmn:outgoing>M09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Decision" name="Решение покупателя?">
      <bpmn:incoming>M09</bpmn:incoming>
      <bpmn:outgoing>M10</bpmn:outgoing>
      <bpmn:outgoing>M12</bpmn:outgoing>
      <bpmn:outgoing>M13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Change" name="Выбрать вариант для нового сравнения">
      <bpmn:documentation>Можно повторить обработку того же варианта с новыми входами. Каждый оттенок накладывается на исходное изображение, а не на предыдущий результат.</bpmn:documentation>
      <bpmn:incoming>M10</bpmn:incoming>
      <bpmn:outgoing>M11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Selection" name="Предоставить результат предварительного выбора">
      <bpmn:documentation>При выборе передать выбранный variant_id; при выходе без выбора — None. Это два нормальных исхода, а не ошибка ввода.</bpmn:documentation>
      <bpmn:incoming>M12</bpmn:incoming>
      <bpmn:incoming>M13</bpmn:incoming>
      <bpmn:outgoing>M14</bpmn:outgoing>
      <bpmn:ioSpecification id="Task_Selection_IO">
        <bpmn:dataOutput id="D_SelectionOut_Output"/>
        <bpmn:inputSet id="Task_Selection_InputSet"/>
        <bpmn:outputSet id="Task_Selection_OutputSet">
          <bpmn:dataOutputRefs>D_SelectionOut_Output</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="D_SelectionOut">
        <bpmn:sourceRef>D_SelectionOut_Output</bpmn:sourceRef>
        <bpmn:targetRef>Data_Selection</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="Task_StopFinal" name="Прекратить AR-просмотр">
      <bpmn:incoming>M14</bpmn:incoming>
      <bpmn:outgoing>M15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Outcome" name="Итог выбора?">
      <bpmn:incoming>M15</bpmn:incoming>
      <bpmn:outgoing>M16</bpmn:outgoing>
      <bpmn:outgoing>M17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Selected" name="Товар и вариант предварительно выбраны">
      <bpmn:incoming>M16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoSelection" name="Просмотр завершён без выбора">
      <bpmn:incoming>M17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="Data_Catalog" name="Каталог: товары, варианты, оттенки, материалы, связи" dataStoreRef="Store_Catalog"/>
    <bpmn:dataObject id="Data_Details_Object"/>
    <bpmn:dataObjectReference id="Data_Details" name="Сведения о товаре и варианте; оттенок; материалы" dataObjectRef="Data_Details_Object"/>
    <bpmn:dataObject id="Data_Selection_Object"/>
    <bpmn:dataObjectReference id="Data_Selection" name="Итог: selected / no_selection" dataObjectRef="Data_Selection_Object"/>
    <bpmn:sequenceFlow id="M01" sourceRef="Start_Card" targetRef="GW_Repeat"/>
    <bpmn:sequenceFlow id="M02" sourceRef="GW_Repeat" targetRef="Task_Details"/>
    <bpmn:sequenceFlow id="M03" sourceRef="Task_Details" targetRef="Task_Study"/>
    <bpmn:sequenceFlow id="M04" sourceRef="Task_Study" targetRef="GW_Mode"/>
    <bpmn:sequenceFlow id="M05" sourceRef="GW_Mode" targetRef="Task_StopOrdinary" name="Обычный просмотр">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mode == ordinary</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M06" sourceRef="GW_Mode" targetRef="SubProcess_AR" name="AR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mode == ar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M07" sourceRef="Task_StopOrdinary" targetRef="Task_Compare"/>
    <bpmn:sequenceFlow id="M08" sourceRef="SubProcess_AR" targetRef="Task_Compare"/>
    <bpmn:sequenceFlow id="M09" sourceRef="Task_Compare" targetRef="GW_Decision"/>
    <bpmn:sequenceFlow id="M10" sourceRef="GW_Decision" targetRef="Task_Change" name="Продолжить сравнение">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == compare</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M11" sourceRef="Task_Change" targetRef="GW_Repeat"/>
    <bpmn:sequenceFlow id="M12" sourceRef="GW_Decision" targetRef="Task_Selection" name="Выбрать вариант">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == select; variant_id = current_variant_id</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M13" sourceRef="GW_Decision" targetRef="Task_Selection" name="Завершить без выбора">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == exit; variant_id = None</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M14" sourceRef="Task_Selection" targetRef="Task_StopFinal"/>
    <bpmn:sequenceFlow id="M15" sourceRef="Task_StopFinal" targetRef="GW_Outcome"/>
    <bpmn:sequenceFlow id="M16" sourceRef="GW_Outcome" targetRef="End_Selected" name="selected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == selected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M17" sourceRef="GW_Outcome" targetRef="End_NoSelection" name="no_selection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == no_selection</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Main">
    <bpmn:participant id="Pool_Selection" name="Ознакомление с товаром и предварительный выбор" processRef="Process_Selection"/>
    <bpmn:participant id="Pool_Seller" name="Представитель продавца"/>
    <bpmn:textAnnotation id="Note_Catalog">
