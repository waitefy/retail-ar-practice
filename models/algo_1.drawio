        <mxCell id="point_init" value="inside := False; K := len(contour)" style="shape=rectangle;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="280" width="360" height="60"/>
        </mxCell>
        <mxCell id="point_iinit" value="i := 0" style="shape=hexagon;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="380" width="300" height="60"/>
        </mxCell>
        <mxCell id="point_itest" value="i &lt; K?" style="shape=rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="480" width="240" height="100"/>
        </mxCell>
        <mxCell id="point_ends" value="a := contour[i]&#10;b := contour[(i + 1) mod K]" style="shape=rectangle;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="620" width="360" height="60"/>
        </mxCell>
        <mxCell id="point_boundary" value="point лежит&#10;на отрезке [a, b]?" style="shape=rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1860" y="720" width="280" height="120"/>
        </mxCell>
        <mxCell id="point_true" value="Вывод True" style="shape=parallelogram;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="750" width="260" height="60"/>
        </mxCell>
        <mxCell id="point_crosses" value="(a.y &gt; point.y) ≠&#10;(b.y &gt; point.y)?" style="shape=rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1860" y="900" width="280" height="120"/>
        </mxCell>
        <mxCell id="point_side" value="side := cross(a, b, point)" style="shape=rectangle;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="1060" width="360" height="60"/>
        </mxCell>
        <mxCell id="point_right" value="(side &gt; 0 и b.y &gt; a.y)&#10;или&#10;(side &lt; 0 и b.y &lt; a.y)?" style="shape=rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1840" y="1160" width="320" height="140"/>
        </mxCell>
        <mxCell id="point_toggle" value="inside := not inside" style="shape=rectangle;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="1360" width="300" height="60"/>
        </mxCell>
        <mxCell id="point_inc" value="i := i + 1" style="shape=rectangle;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="1500" width="300" height="60"/>
        </mxCell>
        <mxCell id="point_result" value="Вывод inside" style="shape=parallelogram;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="620" width="260" height="60"/>
        </mxCell>
        <mxCell id="point_end" value="Конец" style="shape=ellipse;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1920" y="1740" width="160" height="40"/>
        </mxCell>
        <mxCell id="point_note" value="on_segment(a, b, point):&#10;cross(a,b,point) = 0 и&#10;координаты point лежат между&#10;координатами a и b включительно.&#10;&#10;cross(a,b,p) =&#10;(b.x−a.x)(p.y−a.y) −&#10;(b.y−a.y)(p.x−a.x).&#10;Вычисления выполняются&#10;точными дробями." style="shape=rectangle;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;strokeColor=none;fillColor=none;strokeWidth=1;spacing=4;rounded=0;" vertex="1" parent="1">
